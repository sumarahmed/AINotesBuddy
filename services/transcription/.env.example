# Optional model and service configuration. Do not commit real tokens.
HF_TOKEN=hf_replace_with_your_local_model_access_token
NOTESBUDDY_ACCESS_MODE=local
NOTESBUDDY_ALLOWED_ORIGINS=null,http://127.0.0.1:4173,http://localhost:4173,https://your-static-site.example
NOTESBUDDY_WHISPER_MODEL=small
NOTESBUDDY_MODEL_DEVICE=cpu
NOTESBUDDY_WHISPER_COMPUTE_TYPE=int8
NOTESBUDDY_MAX_WORKERS=1
NOTESBUDDY_MAX_JOBS=64
NOTESBUDDY_JOB_RETENTION_SECONDS=3600
NOTESBUDDY_MAX_TOTAL_UPLOAD_BYTES=6442450944
NOTESBUDDY_MAX_DURATION_MS=7200000

# Hosted anonymous mode only. Prefer the deployment manifest's conservative
# values and store HF_TOKEN in the provider's secret manager.
NOTESBUDDY_SESSION_TTL_SECONDS=86400
NOTESBUDDY_MAX_SESSIONS=2048
NOTESBUDDY_SESSION_ISSUE_WINDOW_SECONDS=3600
NOTESBUDDY_MAX_SESSIONS_PER_CLIENT=10
NOTESBUDDY_JOB_LIMIT_WINDOW_SECONDS=3600
NOTESBUDDY_MAX_JOBS_PER_SESSION=3
NOTESBUDDY_MAX_ACTIVE_JOBS_PER_SESSION=1
